# Ethereum address to receive x402 USDC payments (Base Sepolia testnet)
SERVER_ADDRESS=0xYourWalletAddressHere

# ntfy.sh topic for mobile CAPTCHA alerts (subscribe on your phone)
NTFY_TOPIC=hitl-captcha-alerts

# CDP facilitator (required for x402 Bazaar discovery indexing)
# Create keys at https://portal.cdp.coinbase.com/
CDP_API_KEY_ID=organizations/.../apiKeys/...
CDP_API_KEY_SECRET=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n

# Optional: override x402 payment settings
# X402_NETWORK=eip155:84532
# X402_PRICE=$0.25
