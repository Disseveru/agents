{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hitl-captcha-x402",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "MYBROWSER",
    "remote": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CAPTCHA_SESSION",
        "class_name": "CaptchaSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CaptchaSession"]
    }
  ],
  "vars": {
    "NTFY_TOPIC": "hitl-captcha-alerts",
    "X402_NETWORK": "eip155:8453",
    "X402_PRICE": "$0.0001",
    "SESSION_TTL_SECONDS": "900"
  },
  "observability": {
    "enabled": true
  }
}
