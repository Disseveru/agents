{
  "description": "Repository secrets synced from Cursor Cloud / local env via pnpm run github:sync-secrets",
  "secrets": [
    "CLOUDFLARE_ACCOUNT_ID",
    "CLOUDFLARE_API_TOKEN",
    "CF_AI_GATEWAY_ACCOUNT_ID",
    "CF_AI_GATEWAY_TOKEN"
  ],
  "envAliases": {
    "CLOUDFLARE_ACCOUNT_ID": [
      "CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_ACCOUNT__ID"
    ],
    "CF_AI_GATEWAY_ACCOUNT_ID": [
      "CF_AI_GATEWAY_ACCOUNT_ID",
      "CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_ACCOUNT__ID"
    ],
    "CF_AI_GATEWAY_TOKEN": [
      "CF_AI_GATEWAY_TOKEN",
      "CLOUDFLARE_API_TOKEN"
    ]
  }
}
